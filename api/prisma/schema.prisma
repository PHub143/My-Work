// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id           String    @id @default(cuid())
  driveFileId  String    @unique
  name         String
  mimeType     String
  webViewLink  String
  thumbnailLink String?
  size         BigInt?   // Size in bytes
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Future-proofing fields
  owner   User? @relation(fields: [ownerId], references: [id])
  ownerId String?
  tags    Tag[] @relation("FileTags")

  // Multi-drive support
  driveConfig   DriveConfig? @relation(fields: [driveConfigId], references: [id])
  driveConfigId String?
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String?  @unique
  name      String?
  password  String
  role      String   @default("USER")
  roles     Json     @default("[\"STUDENT\"]")
  files     File[]
  practiceResults PracticeResult[]
  feedback  Feedback[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  lastLoginAt DateTime?
}

model PracticeResult {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  raw       Int?
  scaled    Int?
  total     Int?
  duration  Int?
  perPart   Json?
  perTag    Json?
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, kind])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  files File[] @relation("FileTags")
}

model Feedback {
  id             String   @id @default(cuid())
  message        String
  category       String   @default("other") // bug | idea | content | other
  status         String   @default("new")   // new | in_progress | resolved | wont_do
  pageUrl        String? // frontend hash route captured at submit time
  adminNote      String? // internal, admin-only
  attachments    Json     @default("[]") // [{ driveFileId, mimeType, name }]

  // Author relation is optional and nulled on user deletion; the email/name
  // snapshot below keeps the submitter identifiable after that.
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  submitterEmail String?
  submitterName  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model DriveConfig {
  id           String   @id @default(cuid())
  name         String   @default("Default Drive")
  clientId     String
  clientSecret String   // Encrypted
  redirectUri  String
  refreshToken String?  // Encrypted
  folderId     String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  files        File[]
}

// Admin Inbox: one row per connected mailbox. OAuth credentials are separate
// from DriveConfig. clientSecret/refreshToken are AES-256-GCM encrypted via
// utils/encryption.js and are never returned by the API.
model MailAccount {
  id                   String    @id @default(cuid())
  provider             String    @default("gmail")
  name                 String    @default("Gmail")
  emailAddress         String?
  clientId             String?
  clientSecret         String?   // Encrypted
  redirectUri          String?
  refreshToken         String?   // Encrypted
  grantedScopes        String?   // space-separated scopes returned by the provider
  allowPermanentDelete Boolean   @default(false)
  status               String    @default("disconnected") // disconnected | connected | reauth_required
  providerConfig       Json      @default("{}")
  isDefault            Boolean   @default(false)
  connectedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([provider, emailAddress])
}
